{
  "$schema": "https://calm.finos.org/draft/2026-03/meta/calm.json",
  "$id": "calm-demo:patterns:oauth-api-security",
  "unique-id": "oauth-api-security-pattern",
  "title": "OAuth API Security (plain)",
  "description": "OAuth API security pattern using plain CALM nodes — no standard node references, no auto-resolved controls.",
  "category": "api-security",
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 5,
      "prefixItems": [
        {
          "$ref": "https://calm.finos.org/calm/schemas/2025-03/meta/core.json#/defs/node",
          "properties": {
            "unique-id": { "const": "web-client" },
            "node-type": { "const": "webclient" },
            "name": { "const": "Web Application" }
          }
        },
        {
          "$ref": "https://calm.finos.org/calm/schemas/2025-03/meta/core.json#/defs/node",
          "properties": {
            "unique-id": { "const": "api-gateway" },
            "node-type": { "const": "service" },
            "name": { "const": "API Gateway" }
          }
        },
        {
          "$ref": "https://calm.finos.org/calm/schemas/2025-03/meta/core.json#/defs/node",
          "properties": {
            "unique-id": { "const": "token-authority" },
            "node-type": { "const": "service" },
            "name": { "const": "Token Authority" }
          }
        },
        {
          "$ref": "https://calm.finos.org/calm/schemas/2025-03/meta/core.json#/defs/node",
          "properties": {
            "unique-id": { "const": "backend-api" },
            "node-type": { "const": "service" },
            "name": { "const": "Backend API" }
          }
        },
        {
          "$ref": "https://calm.finos.org/calm/schemas/2025-03/meta/core.json#/defs/node",
          "properties": {
            "unique-id": { "const": "database" },
            "node-type": { "const": "database" },
            "name": { "const": "Database" }
          }
        }
      ]
    },
    "relationships": {
      "type": "array",
      "minItems": 5,
      "prefixItems": [
        {
          "$ref": "https://calm.finos.org/calm/schemas/2025-03/meta/core.json#/defs/relationship",
          "properties": {
            "unique-id": { "const": "client-to-gateway" },
            "relationship-type": { "const": { "connects": { "source": { "node": "web-client" }, "destination": { "node": "api-gateway" } } } },
            "description": { "const": "HTTPS request" }
          }
        },
        {
          "$ref": "https://calm.finos.org/calm/schemas/2025-03/meta/core.json#/defs/relationship",
          "properties": {
            "unique-id": { "const": "gateway-to-token-authority" },
            "relationship-type": { "const": { "connects": { "source": { "node": "api-gateway" }, "destination": { "node": "token-authority" } } } },
            "description": { "const": "Validate OAuth token" }
          }
        },
        {
          "$ref": "https://calm.finos.org/calm/schemas/2025-03/meta/core.json#/defs/relationship",
          "properties": {
            "unique-id": { "const": "gateway-to-backend" },
            "relationship-type": { "const": { "connects": { "source": { "node": "api-gateway" }, "destination": { "node": "backend-api" } } } },
            "description": { "const": "Authorized request" }
          }
        },
        {
          "$ref": "https://calm.finos.org/calm/schemas/2025-03/meta/core.json#/defs/relationship",
          "properties": {
            "unique-id": { "const": "client-to-token-authority" },
            "relationship-type": { "const": { "connects": { "source": { "node": "web-client" }, "destination": { "node": "token-authority" } } } },
            "description": { "const": "Obtain OAuth token" }
          }
        },
        {
          "$ref": "https://calm.finos.org/calm/schemas/2025-03/meta/core.json#/defs/relationship",
          "properties": {
            "unique-id": { "const": "backend-to-database" },
            "relationship-type": { "const": { "connects": { "source": { "node": "backend-api" }, "destination": { "node": "database" } } } },
            "description": { "const": "Read/write data" }
          }
        }
      ]
    }
  },
  "required": ["nodes", "relationships"]
}
